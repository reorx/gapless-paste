// 在项目根目录运行：bash ~/.claude/skills/macos-app-bootstrap/scripts/setup-signing.sh
// 已有 Local.xcconfig 时加 --force；也可复制本文件后填入你的 Team ID（已 gitignore）。
// 仅影响 Debug 构建（Debug.xcconfig 末尾 include），Release 用 Developer ID。
// 优先选付费 Team：APPLE_TEAM_ID 环境变量 > ~/Sync/apple-developer/secrets.env 同名变量 > 唯一有效 Team。
// 脚本验证所选 Team 的有效 Apple Development 身份；多 Team 未指定时会报错，不按证书顺序猜测。
DEVELOPMENT_TEAM = XXXXXXXXXX
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
